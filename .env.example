# ==============================================================================
# PLANTILLA DE CONFIGURACION - PLATAFORMA DUTS UTS (.env.example)
# ==============================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# En proveedores de hosting (Render, Railway, Clever Cloud), registra estas
# variables en el apartado "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (MYSQL / TIDB CLOUD / RAILWAY / AIVEN)
# ------------------------------------------------------------------------------
# URL completa JDBC (si se define, tiene prioridad sobre host/port):
DB_URL=jdbc:mysql://localhost:3306/duts?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# Parametros desglosados (utilizados si DB_URL no esta presente):
DB_HOST=localhost
DB_PORT=3306
DB_NAME=duts
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. CONFIGURACION DEL SERVIDOR Y APLICACION
# ------------------------------------------------------------------------------
PORT=8081
APP_ENV=production
APP_URL=https://tu-dominio.onrender.com
APP_NAME="Plataforma DUTS UTS"

# ------------------------------------------------------------------------------
# 3. SEGURIDAD INSTITUCIONAL
# ------------------------------------------------------------------------------
CSRF_SECRET=cambiar_por_una_clave_aleatoria_segura_de_produccion
SESSION_TIMEOUT_MINUTES=30

# ------------------------------------------------------------------------------
# 4. RED UNIVERSITARIA Y APIS
# ------------------------------------------------------------------------------
EVENTOS_API_ENABLED=true
CIUDAD_SEDE=Bucaramanga
