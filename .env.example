# ==============================================================================
# PLANTILLA DE CONFIGURACION - PLATAFORMA DUTS UTS (.env.example)
# ==============================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# Para despliegue en la nube (Render, Railway, Clever Cloud), agrega estas
# mismas variables en la seccion "Environment Variables" de tu dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (MYSQL / TIDB CLOUD / AWS)
# ------------------------------------------------------------------------------
DB_URL=jdbc:mysql://tu-host-de-base-de-datos:4000/duts?useSSL=true&sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&connectTimeout=30000&socketTimeout=60000
DB_HOST=tu-host-de-base-de-datos
DB_PORT=4000
DB_NAME=duts
DB_USER=tu_usuario
DB_PASSWORD=tu_password_secreta
DB_SSL=true

# Configuracion del Pool de Conexiones HikariCP
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y CONTROL DE ACCESO (CONFIDENCIAL)
# ------------------------------------------------------------------------------
# Semilla institucional para verificacion y firma criptografica de tokens CSRF
CSRF_SECRET=cambiar_por_una_clave_aleatoria_larga_y_segura_de_produccion

# Duracion de la sesion HTTP de usuario en minutos
SESSION_TIMEOUT_MINUTES=30

# Parametros de mitigacion contra ataques de fuerza bruta (Rate Limiting)
SECURITY_MAX_LOGIN_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=3
SECURITY_WINDOW_MINUTES=3

# ------------------------------------------------------------------------------
# 3. SERVIDOR Y ENTORNO DE EJECUCION
# ------------------------------------------------------------------------------
PORT=8081
APP_ENV=production
APP_URL=https://tu-dominio.onrender.com
APP_NAME="Plataforma DUTS UTS"
APP_VERSION=2.4.0
INSTITUCION_NOMBRE="Unidades Tecnologicas de Santander - UTS"
CIUDAD_SEDE="Bucaramanga, Santander"

# ------------------------------------------------------------------------------
# 4. MODULOS Y APIS
# ------------------------------------------------------------------------------
EVENTOS_API_ENABLED=true
EXPORT_PDF_EMISOR="Direccion Financiera y de Meritos UTS"
APK_PACKAGE_NAME="co.edu.uts.duts"
